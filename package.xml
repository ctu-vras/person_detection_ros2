<package format="3">
  <name>person_detection</name>
  <version>0.0.1</version>
  <description>
    YOLOX-tiny person detection on sensor_msgs/Image, publishing vision_msgs/BoundingBox2DArray and
    vision_msgs/Detection2DArray.
  </description>

  <maintainer email="herolada@fel.cvut.cz">herolada</maintainer>

  <license>MIT</license>

  <author>Adam Herold</author>
  <author>Martin Pecka</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>ament_index_cpp</build_depend>
  <build_depend>cras_cpp_common</build_depend>
  <build_depend>cv_bridge</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>image_geometry</build_depend>
  <build_depend>image_transport</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>rclcpp_components</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>vision_msgs</build_depend>

  <exec_depend>ament_index_cpp</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>cras_cpp_common</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>image_geometry</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_lint_cmake</test_depend>
  <test_depend>cras_lint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
